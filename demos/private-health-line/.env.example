# Private health line. Copy to .env and fill:  cp .env.example .env
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Your model server from compose.yaml, ending in /v1 (https, or http://localhost).
ONPREM_BASE_URL=https://models.example.ca/v1
# Shared bearer key for speaches and vLLM. Generate one: openssl rand -hex 32
ONPREM_API_KEY=
# Shown on screen only; describe where the box actually is.
ONPREM_REGION=Montreal, Canada
ONPREM_GPU=NVIDIA L4 24 GB
# Optional model overrides (defaults match compose.yaml).
# ONPREM_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# ONPREM_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# ONPREM_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# ONPREM_TTS_VOICE=af_heart
